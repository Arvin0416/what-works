# Required for migrations, seeding, scheduled generation, and private review.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/what_works
# Required for live research and article generation; keep server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Required for live approved-channel YouTube discovery; keep server-side only.
YOUTUBE_API_KEY=
# Required to send review email; development can use the provider's no-key fallback.
RESEND_API_KEY=
EMAIL_FROM=What Works Daily <hello@example.com>
ADMIN_EMAIL=
# Required for signed review links; rotating it invalidates existing links.
APPROVAL_SECRET=
# Required for protected cron requests; Vercel sends it as a Bearer token.
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The deployment cron is 23:00 UTC, equivalent to 07:00 Asia/Manila.
DAILY_GENERATION_HOUR=7
